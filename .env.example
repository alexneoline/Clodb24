# ---- Сервер ----
PORT=3000
# Публичный HTTPS-адрес этого сервера (ngrok / cloudflared / VPS). Б24 будет слать события сюда.
PUBLIC_URL=https://example.ngrok-free.app

# ---- Портал ----
B24_DOMAIN=neoline.bitrix24.ru

# ---- Способ вызова REST: oauth | webhook | vibe ----
#  oauth   — токены локального приложения (получаются автоматически при установке, рекомендуется)
#  webhook — входящий вебхук https://neoline.bitrix24.ru/rest/1/xxxxxxxx/
#  vibe    — шлюз Вайбкод (vibecode.bitrix24.tech)
B24_TRANSPORT=oauth

# Для oauth: из карточки локального приложения (Разработчикам → Другое → Локальное приложение)
B24_CLIENT_ID=local.xxxxxxxxxxxxxx.xxxxxxxx
B24_CLIENT_SECRET=

# Для webhook:
B24_WEBHOOK_URL=

# Для vibe:
VIBE_API_URL=https://vibecode.bitrix24.tech/v1
VIBE_API_KEY=
VIBE_AUTH_HEADER=X-Api-Key

# application_token из события (проверка, что запрос пришёл от вашего портала).
# При oauth-установке сохраняется автоматически; для исходящего вебхука — скопируйте "Токен приложения".
B24_APP_TOKEN=

# ---- Каталог ----
# ID инфоблока(ов) каталога товаров через запятую (catalog.catalog.list покажет iblockId)
CATALOG_IBLOCK_IDS=
# Поле, в котором хранится артикул: property<ID> (например property105 для свойства ARTNUMBER), xmlId или code
SKU_FIELD=property105
# Регулярка артикула в названии товара; группа 1 = артикул
SKU_REGEX=\[(SKU-[A-Za-z0-9._\/-]+)\]
